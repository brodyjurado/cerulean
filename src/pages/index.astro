---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			:global(body) {
				background: 
					radial-gradient(circle at 10% 20%, rgba(0, 255, 135, 0.6) 0%, rgba(0, 255, 135, 0) 40%),
					radial-gradient(circle at 90% 80%, rgba(0, 242, 254, 0.6) 0%, rgba(0, 242, 254, 0) 50%),
					radial-gradient(circle at 50% 50%, rgba(79, 172, 254, 0.5) 0%, rgba(79, 172, 254, 0) 70%),
					linear-gradient(135deg, #0052d4 0%, #4364f7 50%, #6fb1fc 100%) !important;
				background-size: 200% 200% !important;
				background-attachment: fixed !important;
				animation: aurora-mesh 18s ease infinite alternate;
				font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, sans-serif !important;
				position: relative;
				overflow-x: hidden;
				margin: 0;
				padding: 0;
			}

			:global(body)::before {
				content: '';
				position: absolute;
				top: 0; left: -20%; right: -20%; height: 50vh;
				background: linear-gradient(180deg, rgba(255,255,255,0.45) 0%, rgba(255,255,255,0.15) 30%, rgba(255,255,255,0) 100%);
				border-bottom: 3px solid rgba(255,255,255,0.4);
				border-radius: 0 0 60% 40%;
				pointer-events: none;
				z-index: 1;
				box-shadow: inset 0 2px 10px rgba(255,255,255,0.5);
			}

			.page-wrapper {
				display: flex;
				flex-direction: column;
				min-height: 100vh;
				position: relative;
				z-index: 2;
			}

			.viewport-center {
				display: flex;
				justify-content: center;
				align-items: center;
				flex-grow: 1;
				box-sizing: border-box;
				padding: 3rem 1.5rem;
			}

			.hero-box {
				background: linear-gradient(135deg, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.1) 100%);
				backdrop-filter: blur(25px) saturate(200%);
				-webkit-backdrop-filter: blur(25px) saturate(200%);
				border-top: 2px solid rgba(255, 255, 255, 0.6);
				border-left: 2px solid rgba(255, 255, 255, 0.5);
				border-right: 1px solid rgba(255, 255, 255, 0.2);
				border-bottom: 1px solid rgba(255, 255, 255, 0.2);
				border-radius: 30px;
				padding: 4rem 3rem;
				text-align: center;
				box-shadow: 
					0 30px 60px rgba(0, 30, 90, 0.25), 
					inset 0 1px 2px rgba(255, 255, 255, 0.6),
					inset 0 -10px 30px rgba(255, 255, 255, 0.1);
				position: relative;
				overflow: hidden;
				max-width: 680px;
				width: 100%;
			}

			.hero-box::after {
				content: '';
				position: absolute;
				top: -10%; left: -10%; width: 120%; height: 55%;
				background: linear-gradient(180deg, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0.05) 90%, rgba(255,255,255,0) 100%);
				border-bottom: 1px solid rgba(255,255,255,0.4);
				border-radius: 0 0 50% 50%;
				pointer-events: none;
			}

			h1 {
				font-size: 3rem;
				color: #ffffff;
				text-shadow: 
					0 2px 4px rgba(0, 40, 120, 0.5), 
					0 0 20px rgba(255, 255, 255, 0.6),
					0 0 30px rgba(0, 242, 254, 0.5);
				margin: 0 0 1.25rem 0;
				font-weight: 800;
				letter-spacing: -0.5px;
			}

			p {
				color: #ffffff;
				text-shadow: 0 1px 3px rgba(0, 20, 70, 0.6);
				font-size: 1.2rem;
				line-height: 1.6;
				margin: 0 auto;
				font-weight: 500;
			}

			:global(footer) {
				background: linear-gradient(to bottom, rgba(255,255,255,0.15), rgba(255,255,255,0.25)) !important;
				backdrop-filter: blur(15px) saturate(150%);
				-webkit-backdrop-filter: blur(15px) saturate(150%);
				color: #ffffff !important;
				border-top: 1px solid rgba(255, 255, 255, 0.4) !important;
				text-shadow: 0 1px 2px rgba(0, 20, 60, 0.4);
				padding: 1.75rem !important;
				box-shadow: inset 0 1px 0 rgba(255,255,255,0.3);
			}

			.bg-fx {
				position: fixed;
				bottom: 0; left: 0; width: 100%; height: 100%;
				z-index: 0;
				pointer-events: none;
			}
			.node-item {
				position: absolute;
				bottom: -120px;
				background: radial-gradient(circle at 35% 35%, rgba(255,255,255,0.55), rgba(0,242,254,0.2));
				border: 1px solid rgba(255,255,255,0.45);
				border-radius: 50%;
				box-shadow: inset 0 0 12px rgba(255,255,255,0.6);
				animation: float-up 15s infinite linear;
			}
			.n1 { left: 7%; width: 85px; height: 85px; animation-duration: 16s; }
			.n2 { left: 26%; width: 45px; height: 45px; animation-duration: 10s; animation-delay: 2s; }
			.n3 { left: 68%; width: 120px; height: 120px; animation-duration: 20s; animation-delay: 0.5s; }
			.n4 { left: 88%; width: 55px; height: 55px; animation-duration: 12s; animation-delay: 4s; }

			@keyframes float-up {
				0% { transform: translateY(0) scale(0.9); opacity: 0; }
				10% { opacity: 0.8; }
				90% { opacity: 0.4; }
				100% { transform: translateY(-125vh) scale(1.1); opacity: 0; }
			}

			@keyframes aurora-mesh {
				0% { background-position: 0% 50%; }
				100% { background-position: 100% 50%; }
			}
		</style>
	</head>
	<body>
		<div class="bg-fx">
			<div class="node-item n1"></div>
			<div class="node-item n2"></div>
			<div class="node-item n3"></div>
			<div class="node-item n4"></div>
		</div>

		<div class="page-wrapper">
			<div class="viewport-center">
				<main class="hero-box">
					<h1>System Initializing</h1>
					<p>
						The digital workspace is currently undergoing routine technical calibration. 
						A dynamic portfolio showcasing engineering modules, sound designs, and visual layout frameworks will be online shortly.
					</p>
				</main>
			</div>
			
			<Footer />
		</div>
	</body>
</html>
