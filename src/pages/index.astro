---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			:global(body) {
				background: linear-gradient(135deg, #0072ff 0%, #3a7bd5 35%, #00ff87 100%) !important;
				background-attachment: fixed !important;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
				position: relative;
				overflow-x: hidden;
				margin: 0;
				padding: 0;
			}

			:global(body)::before {
				content: '';
				position: absolute;
				top: 0; left: 0; right: 0; height: 45vh;
				background: linear-gradient(to bottom, rgba(255,255,255,0.35), rgba(255,255,255,0));
				border-bottom: 1px solid rgba(255,255,255,0.25);
				pointer-events: none;
				z-index: 1;
			}

			.page-wrapper {
				display: flex;
				flex-direction: column;
				min-height: 100vh;
				position: relative;
				z-index: 2;
			}

			.viewport-center {
				display: flex;
				justify-content: center;
				align-items: center;
				flex-grow: 1;
				box-sizing: border-box;
				padding: 2rem 1.5rem;
			}

			.hero-box {
				background: rgba(255, 255, 255, 0.2);
				backdrop-filter: blur(12px) saturate(160%);
				-webkit-backdrop-filter: blur(12px) saturate(160%);
				border: 1px solid rgba(255, 255, 255, 0.4);
				border-radius: 20px;
				padding: 3.5rem 2.5rem;
				text-align: center;
				box-shadow: 0 20px 40px rgba(0, 40, 100, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.5);
				position: relative;
				overflow: hidden;
				max-width: 650px;
				width: 100%;
			}

			.hero-box::after {
				content: '';
				position: absolute;
				top: 0; left: -30%; width: 160%; height: 40%;
				background: linear-gradient(rgba(255,255,255,0.25), rgba(255,255,255,0));
				transform: rotate(-8deg);
				pointer-events: none;
			}

			h1 {
				font-size: 2.75rem;
				color: #ffffff;
				text-shadow: 0 2px 8px rgba(0, 40, 100, 0.3), 0 0 15px rgba(0, 255, 135, 0.4);
				margin: 0 0 1rem 0;
				font-weight: 700;
			}

			p {
				color: #ffffff;
				text-shadow: 0 1px 2px rgba(0, 20, 60, 0.4);
				font-size: 1.15rem;
				line-height: 1.6;
				margin: 0 auto 2.5rem auto;
			}

			.meta-links {
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 1rem;
			}

			.btn-pill {
				background: linear-gradient(#ffffff 0%, #f1f5f9 50%, #e2e8f0 51%, #cbd5e1 100%);
				color: #0f172a;
				padding: 0.65rem 1.5rem;
				border-radius: 30px;
				font-size: 0.95rem;
				font-weight: 600;
				box-shadow: 0 4px 6px rgba(0,0,0,0.1), inset 0 1px 0 #ffffff;
				border: 1px solid #94a3b8;
			}

			:global(footer) {
				background: rgba(255, 255, 255, 0.1) !important;
				backdrop-filter: blur(5px);
				color: #ffffff !important;
				border-top: 1px solid rgba(255, 255, 255, 0.2) !important;
				text-shadow: 0 1px 2px rgba(0, 20, 60, 0.4);
				padding: 1.5rem !important;
			}

			.bg-fx {
				position: fixed;
				bottom: 0; left: 0; width: 100%; height: 100%;
				z-index: 0;
				pointer-events: none;
			}
			.node-item {
				position: absolute;
				bottom: -100px;
				background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.35), rgba(0,255,135,0.15));
				border: 1px solid rgba(255,255,255,0.3);
				border-radius: 50%;
				animation: float-up 14s infinite linear;
			}
			.n1 { left: 8%; width: 70px; height: 70px; animation-duration: 15s; }
			.n2 { left: 28%; width: 35px; height: 35px; animation-duration: 9s; animation-delay: 1.5s; }
			.n3 { left: 70%; width: 90px; height: 90px; animation-duration: 19s; animation-delay: 0.5s; }
			.n4 { left: 85%; width: 45px; height: 45px; animation-duration: 11s; animation-delay: 3s; }

			@keyframes float-up {
				0% { transform: translateY(0); opacity: 0; }
				15% { opacity: 0.7; }
				85% { opacity: 0.3; }
				100% { transform: translateY(-125vh); opacity: 0; }
			}
		</style>
	</head>
	<body>
		<div class="bg-fx">
			<div class="node-item n1"></div>
			<div class="node-item n2"></div>
			<div class="node-item n3"></div>
			<div class="node-item n4"></div>
		</div>

		<div class="page-wrapper">
			<div class="viewport-center">
				<main class="hero-box">
					<h1>Under Construction</h1>
					<p>
						Under Construction
					</p>
					
					<div class="meta-links">
						<span class="btn-pill">Engtest</span>
						<span class="btn-pill">Music</span>
						<span class="btn-pill">Photo gallery</span>
					</div>
				</main>
			</div>
			
			<Footer />
		</div>
	</body>
</html>
