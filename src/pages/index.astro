---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			:global(body) {
				background: 
					radial-gradient(circle at 20% 20%, rgba(56, 189, 248, 0.45) 0%, rgba(56, 189, 248, 0) 35%),
					radial-gradient(circle at 80% 15%, rgba(34, 197, 94, 0.4) 0%, rgba(34, 197, 94, 0) 40%),
					radial-gradient(circle at 90% 80%, rgba(6, 182, 212, 0.45) 0%, rgba(6, 182, 212, 0) 45%),
					radial-gradient(circle at 15% 85%, rgba(22, 163, 74, 0.35) 0%, rgba(22, 163, 74, 0) 40%),
					radial-gradient(circle at 50% 50%, rgba(14, 165, 233, 0.3) 0%, rgba(14, 165, 233, 0) 60%),
					linear-gradient(135deg, #0b419c 0%, #1e40af 25%, #0369a1 50%, #1d4ed8 75%, #10b981 100%) !important;
				background-size: 300% 300% !important;
				background-attachment: fixed !important;
				animation: fluid-aurora 22s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
				font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, sans-serif !important;
				position: relative;
				overflow-x: hidden;
				margin: 0;
				padding: 0;
			}

			:global(body)::before {
				content: '';
				position: absolute;
				top: -10%; left: -30%; width: 160%; height: 60vh;
				background: linear-gradient(180deg, rgba(255,255,255,0.55) 0%, rgba(255,255,255,0.2) 25%, rgba(255,255,255,0) 100%);
				border-bottom: 3.5px solid rgba(255,255,255,0.55);
				border-radius: 0 0 50% 60%;
				pointer-events: none;
				z-index: 1;
				box-shadow: inset 0 4px 20px rgba(255,255,255,0.6), 0 8px 32px rgba(0, 100, 255, 0.15);
				transform: rotate(-3deg);
			}

			:global(body)::after {
				content: '';
				position: absolute;
				bottom: 0; left: -10%; width: 120%; height: 35vh;
				background: radial-gradient(ellipse at 50% 100%, rgba(52, 211, 153, 0.25) 0%, rgba(52, 211, 153, 0) 70%);
				pointer-events: none;
				z-index: 1;
			}

			.page-wrapper {
				display: flex;
				flex-direction: column;
				min-height: 100vh;
				position: relative;
				z-index: 2;
			}

			.viewport-center {
				display: flex;
				justify-content: center;
				align-items: center;
				flex-grow: 1;
				box-sizing: border-box;
				padding: 4rem 2rem;
			}

			.hero-box {
				background: linear-gradient(145deg, rgba(255, 255, 255, 0.35) 0%, rgba(240, 249, 255, 0.15) 60%, rgba(209, 250, 229, 0.1) 100%);
				backdrop-filter: blur(30px) saturate(220%);
				-webkit-backdrop-filter: blur(30px) saturate(220%);
				border-top: 2.5px solid rgba(255, 255, 255, 0.7);
				border-left: 2.5px solid rgba(255, 255, 255, 0.55);
				border-right: 1.5px solid rgba(255, 255, 255, 0.25);
				border-bottom: 1.5px solid rgba(255, 255, 255, 0.2);
				border-radius: 40px;
				padding: 5rem 4rem;
				text-align: center;
				box-shadow: 
					0 40px 80px rgba(2, 44, 114, 0.35), 
					inset 0 2px 4px rgba(255, 255, 255, 0.7),
					inset 0 -15px 35px rgba(255, 255, 255, 0.15),
					0 0 40px rgba(56, 189, 248, 0.15);
				position: relative;
				overflow: hidden;
				max-width: 720px;
				width: 100%;
				transform: perspective(1000px) rotateX(1deg);
			}

			.hero-box::before {
				content: '';
				position: absolute;
				top: -25%; left: -25%; width: 150%; height: 70%;
				background: linear-gradient(180deg, rgba(255,255,255,0.45) 0%, rgba(255,255,255,0.08) 85%, rgba(255,255,255,0) 100%);
				border-bottom: 2px solid rgba(255,255,255,0.45);
				border-radius: 0 0 65% 55%;
				pointer-events: none;
				z-index: 1;
			}

			.hero-box::after {
				content: '';
				position: absolute;
				bottom: -15%; right: -15%; width: 60%; height: 60%;
				background: radial-gradient(circle, rgba(52, 211, 153, 0.2) 0%, rgba(52, 211, 153, 0) 70%);
				pointer-events: none;
			}

			h1 {
				font-size: 3.5rem;
				font-weight: 900;
				margin: 0 0 1rem 0;
				letter-spacing: -1px;
				background: linear-gradient(to bottom, #ffffff 0%, #e0f2fe 60%, #bae6fd 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				filter: drop-shadow(0 4px 8px rgba(2, 44, 114, 0.45)) drop-shadow(0 0 25px rgba(56, 189, 248, 0.6));
				position: relative;
				z-index: 2;
			}

			p {
				color: #ffffff;
				text-shadow: 
					0 1px 3px rgba(2, 44, 114, 0.7),
					0 2px 8px rgba(2, 44, 114, 0.4);
				font-size: 1.3rem;
				line-height: 1.7;
				margin: 0 auto;
				font-weight: 500;
				max-width: 580px;
				position: relative;
				z-index: 2;
			}

			:global(footer) {
				background: linear-gradient(180deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.22) 100%) !important;
				backdrop-filter: blur(20px) saturate(160%) !important;
				-webkit-backdrop-filter: blur(20px) saturate(160%) !important;
				color: #ffffff !important;
				border-top: 2px solid rgba(255, 255, 255, 0.45) !important;
				text-shadow: 0 1px 3px rgba(2, 44, 114, 0.5);
				padding: 2rem !important;
				box-shadow: inset 0 1px 0 rgba(255,255,255,0.35), 0 -10px 30px rgba(0,0,0,0.05);
			}

			.dynamic-sphere-layer {
				position: fixed;
				top: 0; left: 0; width: 100%; height: 100%;
				z-index: 0;
				pointer-events: none;
			}

			.orb-node {
				position: absolute;
				bottom: -150px;
				border-radius: 50%;
				background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.65) 0%, rgba(56, 189, 248, 0.25) 40%, rgba(16, 185, 129, 0.1) 80%, rgba(255, 255, 255, 0) 100%);
				border-top: 1.5px solid rgba(255, 255, 255, 0.6);
				border-left: 1.5px solid rgba(255, 255, 255, 0.5);
				border-right: 1px solid rgba(255, 255, 255, 0.15);
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
				box-shadow: 
					inset 0 4px 12px rgba(255, 255, 255, 0.5),
					inset 0 -4px 12px rgba(56, 189, 248, 0.2),
					0 15px 30px rgba(2, 44, 114, 0.15);
				animation: float-rise infinite linear;
			}

			.v1 { left: 5%; width: 110px; height: 110px; animation-duration: 24s; animation-timing-function: ease-in-out; }
			.v2 { left: 22%; width: 55px; height: 55px; animation-duration: 14s; animation-delay: 3s; }
			.v3 { left: 45%; width: 140px; height: 140px; animation-duration: 28s; animation-delay: 1s; animation-timing-function: ease-in-out; }
			.v4 { left: 72%; width: 70px; height: 70px; animation-duration: 17s; animation-delay: 5s; }
			.v5 { left: 88%; width: 95px; height: 95px; animation-duration: 20s; animation-delay: 2s; }

			.vector-stream {
				position: fixed;
				top: 0; left: 0; width: 100%; height: 100%;
				z-index: 0;
				pointer-events: none;
				opacity: 0.25;
				stroke: rgba(255, 255, 255, 0.4);
				stroke-width: 1.5;
				fill: none;
			}

			@keyframes float-rise {
				0% { transform: translateY(0) scale(0.8) rotate(0deg); opacity: 0; }
				8% { opacity: 0.85; }
				40% { transform: translateY(-50vh) scale(1.05) rotate(140deg); }
				90% { opacity: 0.45; }
				100% { transform: translateY(-130vh) scale(0.9) rotate(360deg); opacity: 0; }
			}

			@keyframes fluid-aurora {
				0% { background-position: 0% 30%; }
				50% { background-position: 50% 70%; }
				100% { background-position: 100% 30%; }
			}

			@media (max-width: 768px) {
				.hero-box { padding: 3.5rem 2rem; border-radius: 30px; }
				h1 { font-size: 2.5rem; }
				p { font-size: 1.15rem; }
			}
		</style>
	</head>
	<body>
		<svg class="vector-stream" viewBox="0 0 1440 900" preserveAspectRatio="none">
			<path d="M-100,200 C300,400 500,100 900,500 C1200,800 1300,300 1600,600" />
			<path d="M-50,250 C350,420 450,150 850,480 C1150,750 1350,350 1650,550" style="stroke: rgba(56, 189, 248, 0.3); stroke-width: 1;" />
		</svg>

		<div class="dynamic-sphere-layer">
			<div class="orb-node v1"></div>
			<div class="orb-node v2"></div>
			<div class="orb-node v3"></div>
			<div class="orb-node v4"></div>
			<div class="orb-node v5"></div>
		</div>

		<div class="page-wrapper">
			<div class="viewport-center">
				<main class="hero-box">
					<h1>Under Construction</h1>
					<p>Under Construction</p>
				</main>
			</div>
			
			<Footer />
		</div>
	</body>
</html>
